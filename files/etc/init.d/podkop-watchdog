#!/bin/sh /etc/rc.common
# podkop-watchdog: connectivity monitor and VLESS failover for Podkop.
# shellcheck disable=SC3043 # busybox ash (rc.common) supports local

START=99
STOP=05
USE_PROCD=1
PROG=/usr/bin/podkop-watchdog

start_service() {
	config_load podkop-watchdog
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" run
	# Respawn after 30 s and never give up (retry 0 = unlimited): a watchdog that
	# stays dead is worse than one that restarts. The state machine's persisted
	# schedule prevents request bursts across restarts.
	procd_set_param respawn 3600 30 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger podkop-watchdog
}

reload_service() {
	stop
	start
}
