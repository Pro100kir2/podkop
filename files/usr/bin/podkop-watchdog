#!/bin/sh
# podkop-watchdog: connectivity monitor and VLESS failover for Podkop.
# Usage: podkop-watchdog run|tick|status|diagnose|selfcheck|version|test-candidates|events|notify-test

: "${WD_LIB_DIR:=/usr/lib/podkop-watchdog}"
# Tests run with WD_STRICT=1 to catch unset variables; production stays resilient.
[ "${WD_STRICT:-0}" = 1 ] && set -u

for _m in common checks api candidate machine notify; do
	# shellcheck disable=SC1090
	. "$WD_LIB_DIR/$_m.sh" || {
		echo "podkop-watchdog: cannot load $WD_LIB_DIR/$_m.sh" >&2
		exit 1
	}
done

# CLI commands run beside the daemon: give them their own scratch directory so
# they cannot read or delete the daemon's api.body / clash.out files.
private_tmp() {
	state_defaults # CLI commands do not load the daemon's state
	TMP_DIR="$WD_STATE_DIR/cli.$$"
	mkdir -p "$TMP_DIR" 2>/dev/null && chmod 700 "$TMP_DIR" 2>/dev/null
	trap 'rm -rf "$TMP_DIR"' EXIT
}

acquire_lock() { # -n (fail fast)
	exec 9>"$WD_LOCK_FILE" || return 1
	flock -n 9
}

# After a respawn the previous instance may still be exiting (SIGKILLed, a child
# of it holding the lock for a few seconds): wait instead of failing, otherwise
# procd counts every such attempt as a crash and eventually gives up.
acquire_lock_wait() { # seconds
	exec 9>"$WD_LOCK_FILE" || return 1
	_lw=0
	while ! flock -n 9; do
		[ "$_lw" -ge "$1" ] && return 1
		sleep 2
		_lw=$((_lw + 2))
	done
}

cmd_run() {
	load_config
	if [ "$C_ENABLED" != 1 ]; then
		log notice "disabled in config; exiting"
		exit 0
	fi
	ensure_dirs
	if ! acquire_lock_wait "${WD_LOCK_WAIT:-60}"; then
		log err "another instance is already running"
		echo "podkop-watchdog: already running" >&2
		exit 1
	fi
	_sleep_pid=''
	trap 'log notice "stopping"; [ -n "$_sleep_pid" ] && kill "$_sleep_pid" 2>/dev/null; exit 0' TERM INT HUP
	log notice "started"
	while :; do
		tick
		# fd 9 closed: if we are SIGKILLed, an orphaned sleep must not hold the lock.
		sleep "$DELAY" 8>&- 9>&- &
		_sleep_pid=$!
		wait "$_sleep_pid"
		_sleep_pid=''
	done
}

cmd_tick() {
	load_config
	ensure_dirs
	if ! acquire_lock; then
		echo "podkop-watchdog: already running" >&2
		exit 1
	fi
	tick
	echo "state=$S_STATE next_in=$DELAY"
}

cmd_status() {
	load_config
	if [ -f "$STATE_FILE" ]; then
		cat "$STATE_FILE"
	else
		echo "no state yet ($STATE_FILE)"
	fi
	if [ -n "$(lkg_get)" ]; then
		echo "LKG=present id=$(node_id "$(lkg_get)")"
	else
		echo "LKG=none"
	fi
	echo "ACTIVE_ID=$(node_id "$(current_proxy)")"
}

cmd_diagnose() {
	load_config
	ensure_dirs
	private_tmp
	diagnose
	echo "$S_D_SUMMARY" | tr ',' '\n'
	if api_req GET /health && [ "$(json_field status)" = ok ]; then
		echo "api=1"
	else
		echo "api=0 ($(api_err_desc))"
	fi
	rm -f "$API_BODY"
}

# Dry run: fetch the subscription and test every node in isolation.
# Does not change Podkop. Output contains node ids only.
cmd_test_candidates() {
	load_config
	ensure_dirs
	private_tmp
	exec 8>"$WD_LOCK_FILE.test"
	if ! flock -n 8; then
		echo "a candidate test is already running" >&2
		exit 1
	fi
	_f="$TMP_DIR/dryrun.candidates"
	if ! api_req GET "/vless/sub?$C_SUB_QUERY"; then
		echo "subscription fetch failed ($(api_err_desc))"
		rm -f "$API_BODY"
		exit 1
	fi
	_r=$(parse_subscription "$API_BODY" "$_f")
	rm -f "$API_BODY"
	echo "usable=${_r% *} rejected=${_r#* }"
	_i=0
	while IFS= read -r _u; do
		_i=$((_i + 1))
		if test_candidate "$_u"; then _res=pass; else _res="fail ($T_REASON)"; fi
		echo "#$_i id=$(node_id "$_u") $_res"
	done <"$_f"
	rm -f "$_f"
}

# Important events (notice and above), oldest first.
cmd_events() {
	_n=${1:-50}
	is_uint "$_n" || _n=50
	cat "$WD_EVENT_LOG.1" "$WD_EVENT_LOG" 2>/dev/null | tail -n "$_n"
}

# Send a test Telegram message right now (checks token, chat id and delivery path).
cmd_notify_test() {
	load_config
	ensure_dirs
	private_tmp
	if ! notify_enabled; then
		echo "notifications are not configured (notify, telegram_token, telegram_chat_id)" >&2
		exit 1
	fi
	exec 8>"$WD_LOCK_FILE.test"
	flock -n 8 || {
		echo "a candidate test is running; try again later" >&2
		exit 1
	}
	# shellcheck disable=SC2034 # read by tg_send
	NOTIFY_FORCE_VIA=1
	if tg_send "[$(router_name)] Проверка уведомлений podkop-watchdog: всё работает."; then
		echo "sent"
	else
		echo "not delivered (no direct access and no working VPN node?)" >&2
		exit 1
	fi
}

cmd_version() {
	_v=$(cat "$WD_LIB_DIR/VERSION" 2>/dev/null)
	echo "podkop-watchdog ${_v:-dev}"
}

sc() { # level text
	case "$1" in WARN) _sc_warn=$((_sc_warn + 1)) ;; FAIL) _sc_fail=$((_sc_fail + 1)) ;; esac
	printf '%-5s %s\n' "$1" "$2"
}

# One-shot health report of the whole setup, in plain Russian: what works, what
# is degraded and why. Exit status 1 only if something essential is missing.
cmd_selfcheck() {
	load_config
	ensure_dirs
	private_tmp
	_sc_warn=0 _sc_fail=0
	cmd_version
	for _t in jq curl uci ubus nslookup flock ping md5sum awk sed logger sing-box; do
		command -v "$_t" >/dev/null 2>&1 || sc FAIL "нет команды '$_t' (установите пакет, который её содержит)"
	done
	if [ -x "$WD_PODKOP_INIT" ]; then sc OK "Podkop установлен"; else sc FAIL "Podkop не найден ($WD_PODKOP_INIT)"; fi
	_why=$(compat_probe)
	if [ -z "$_why" ]; then
		sc OK "совместимость с Podkop и sing-box: автопереключение узлов возможно"
	else
		sc WARN "автопереключение узлов будет отключено: $_why"
	fi
	wan_resolve
	if wan_status; then
		sc OK "WAN-интерфейс: $WAN_IF"
	else
		sc WARN "WAN-интерфейс не найден: ремонт WAN выключен, связь оценивается по пингам (задайте wan_interface)"
	fi
	if dnsmasq_running; then
		sc OK "dnsmasq работает"
	elif dnsmasq_managed; then
		sc WARN "dnsmasq включён, но не запущен"
	else
		sc OK "dnsmasq выключен пользователем: watchdog его не трогает"
	fi
	case "$(node_check)" in
	ok) sc OK "Clash API Podkop отвечает, узел проходит проверку" ;;
	fail) sc WARN "Clash API отвечает, но активный узел не проходит проверку" ;;
	*) sc WARN "Clash API Podkop недоступен: автопереключение узлов не сможет проверять VPN" ;;
	esac
	if [ -z "$(singbox_field '.experimental.clash_api.secret')" ] && [ -z "$(podkop_get settings.yacd_secret_key)" ]; then
		[ -r "$WD_SINGBOX_CONFIG" ] && sc WARN "Clash API без пароля: доступен всем устройствам сети (включите yacd secret в Podkop)"
	fi
	if notify_enabled; then sc OK "Telegram-уведомления настроены"; else sc WARN "Telegram не настроен: вы не узнаете о сбоях и о смерти watchdog"; fi
	if [ -e "$WD_WATCHDOG_DEV" ]; then
		sc OK "аппаратный watchdog есть"
	else
		sc WARN "нет аппаратного watchdog: при зависании ядра роутер сам не перезагрузится"
	fi
	_free=$(df -Pk "$WD_PERSIST_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
	if is_uint "$_free" && [ "$_free" -lt 256 ]; then sc WARN "мало места на flash для журнала событий (${_free} КБ)"; fi
	_mem=$(mem_available_kb)
	if [ "$_mem" -lt "$C_MIN_MEM_AVAILABLE_KB" ]; then sc WARN "мало свободной RAM (${_mem} КБ): проверки узлов будут откладываться"; fi
	if [ "$_sc_fail" -gt 0 ]; then
		echo "ИТОГ: есть критичные проблемы ($_sc_fail), предупреждений: $_sc_warn"
		exit 1
	fi
	if [ "$_sc_warn" -gt 0 ]; then echo "ИТОГ: работает, предупреждений: $_sc_warn"; else echo "ИТОГ: всё в порядке"; fi
}

case "${1:-}" in
run) cmd_run ;;
version) cmd_version ;;
selfcheck) cmd_selfcheck ;;
tick) cmd_tick ;;
status) cmd_status ;;
diagnose) cmd_diagnose ;;
test-candidates) cmd_test_candidates ;;
events) cmd_events "${2:-50}" ;;
notify-test) cmd_notify_test ;;
*)
	echo "Usage: $0 run|tick|status|diagnose|selfcheck|version|test-candidates|events [N]|notify-test" >&2
	exit 2
	;;
esac
